orrect": 1, "id": 1, "selected": 0}], "id": 2}, {"_data": [{"type": "question", "contents": [{"content": "frn4le04ob08re4aud04", "type": "audio"}]}, {"type": "post_question", "contents": {"content": "cette p\u00e2te pendant quelques minutes, il l'a finement coup\u00e9e, comme des ficelles ! ", "type": ""}}, {"content": "secondary_2", "type": "objective"}], "responses": [{"_data": [{"content": "", "type": "text"}], "correct": 0, "id": 0, "selected": 0}, {"_data": [{"content": "Apr\u00e8s avoir roul\u00e9 ", "type": "text"}], "correct": 1, "id": 1, "selected": 0}], "id": 3}, {"_data": [{"type": "question", "contents": [{"content": "frn4le04ob08re4aud05", "type": "audio"}, {"content": "Enfin, apr\u00e8s avoir ajout\u00e9 un peu ", "type": "text"}]}, {"type": "post_question", "contents": {"content": "et du piment, il m'a offert ce plat. ", "type": ""}}, {"content": "secondary_2", "type": "objective"}], "responses": [{"_data": [{"content": "", "type": "text"}], "correct": 0, "id": 0, "selected": 0}, {"_data": [{"content": "d'huile de s\u00e9same ", "type": "text"}], "correct": 1, "id": 1, "selected": 0}], "id": 4}, {"_data": [{"type": "question", "contents": [{"content": "", "type": "rec"}]}, {"content": "secondary_2", "type": "objective"}], "responses": [{"_data": [{"content": "", "type": "text"}], "correct": 0, "id": 0, "selected": 0}, {"_data": [{"content": "", "type": "text"}], "correct": 1, "id": 1, "selected": 0}], "id": 5}]}, {"stimuli_ids": [], "id": 3, "_data": [{"type": "instructions", "contents": [{"content": "<span class=\"strong\">C'est \u00e0 vous d'\u00e9crire une histoire. Avant de commencer, il vous faut un plan !</span></br>", "type": "text"}, {"content": "<span class=\"italic\">Consignes : </span> <br><span class=\"bullet italic\">\u00c9crivez un plan d\u00e9taill\u00e9 de votre histoire. Vous avez besoin d'un cadre, de personnages et d'une intrigue.  </span>", "type": "text"}, {"content": "<span class=\"bullet italic\">\u00c9tape 1 : D\u00e9but<ul><li