e"}]}, {"type": "target_word", "contents": [{"content": "la d\u00e9couverte", "type": "name"}, {"content": "l'action de trouver quelque chose en premier", "type": "definition"}, {"content": "(nom f.)", "type": "part_speech"}, {"content": "Exemple : Des arch\u00e9ologues ont fait une d\u00e9couverte surprenante.", "type": "example"}, {"content": "frn4le04ob11aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "Voici des mots \u00e0 r\u00e9viser.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "apprendre", "type": "name"}, {"content": "acqu\u00e9rir une connaissance ou un savoir-faire ; participe pass\u00e9 : appris", "type": "definition"}, {"content": "(verbe)", "type": "part_speech"}, {"content": "Exemple : Si vous voulez apprendre \u00e0 skier n'oubliez pas certains conseils importants.", "type": "example"}, {"content": "frn4le04ob11aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "les bottes", "type": "name"}, {"content": "des chaussures hautes qui couvrent la cheville ", "type": "definition"}, {"content": "(nom f. pl.)", "type": "part_speech"}, {"content": "Exemple : Attachez bien vos bottes. ", "type": "example"}, {"content": "frn4le04ob11aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "le masque de ski", "type": "name"}, {"content": "une protection pour les yeux quand on fait du ski", "type": "definition"}, {"content": "(nom m.)", "type": "part_speech"}, {"content": "Exemple : N'oubliez pas votre masque !", "type": "example"}, {"content": "frn4le04ob11aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "le bonnet", "type": "name"}, {"content": "un accessoire que l'on met sur la t\u00eate pour se couvrir et se r\u00e9chauffer", "type": "definition"}, {"content": "(nom m.)", "type": "part_speech"}, {"content": "Exemple : Pensez \u00e0 prendre votre bonnet.", "type": "example"}, {"content": "frn4le04ob11aud05", "type": "audio"}